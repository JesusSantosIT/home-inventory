# ── Security ──────────────────────────────────────────────────────────
# REQUIRED in production - generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-key
# False in production (enables HTTPS redirects, secure cookies, HSTS)
DEBUG=False
# Your public domain/IP, comma-separated if multiple
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# Public base URL of this instance - used in QR codes
SITE_URL=https://your-domain.com

# ── Behind a reverse proxy (nginx/Caddy terminating TLS) ──────────────
# Set to 1 so Django sees the original HTTPS scheme (required for the API)
TRUST_PROXY=1

# Extra CSRF origins if needed (comma-separated). SITE_URL origin is automatic.
# CSRF_TRUSTED_ORIGINS=https://admin.your-domain.com

# ── Database ──────────────────────────────────────────────────────────
# SQLite is fine for a single-household deployment (default).
# For PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=inventory
# DB_USER=inventory
# DB_PASSWORD=strong-password
# DB_HOST=localhost
# DB_PORT=5432
